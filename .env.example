# Boalix Sync Server — Environment Configuration
# Copy to .env for local development (never commit to Git!)

# Port to listen on
PORT=8080

# SQLite database path
DATABASE_PATH=./boalix-sync.db

# The PUBLIC URL of this server (domain embedded in email tracking links)
# SWAP THIS to a new domain if the current one gets blacklisted!
TRACKING_DOMAIN=http://localhost:8080

# Master secret — used only for tenant registration endpoint
# Generate with: openssl rand -hex 32
API_SECRET=change-me-in-production

# Logging
RUST_LOG=boalix_sync_server=debug,warn
